PORT=3000

# CCAVENUE MODE (live or test)
CCAVENUE_MODE=test

# TEST CREDENTIALS
TEST_MERCHANT_ID=
TEST_ACCESS_CODE=
TEST_WORKING_KEY=

# LIVE CREDENTIALS
LIVE_MERCHANT_ID=
LIVE_ACCESS_CODE=
LIVE_WORKING_KEY=

REDIRECT_URL=
CANCEL_URL=
FRONTEND_URL=
CORS_ORIGIN=

# Email Service
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
BREVO_SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=

# Shared secret required to call POST /email/send (open relay guard)
EMAIL_API_KEY=

# Payment reconciler (server-to-server safety net for stuck 'Awaiting Payment'
# orders). Uses the CCAvenue Order Status API with the same credentials above.
# RECONCILE_INTERVAL_MS: sweep interval, default 300000 (5 min), min 60000.
# RECONCILE_DISABLED=true to turn the reconciler off.
# CCAVENUE_STATUS_URL: override the status API endpoint (defaults to the
# live/test DoWebTrans URL based on CCAVENUE_MODE).
RECONCILE_INTERVAL_MS=
RECONCILE_DISABLED=
CCAVENUE_STATUS_URL=
